[sub_resource type="Shader" id="Shader_vh38o"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled;

// Godot'un kendi derinlik ve ekran dokularını alıyoruz
uniform sampler2D depth_texture : hint_depth_texture, filter_linear_mipmap;
uniform sampler2D screen_texture : hint_screen_texture, filter_linear_mipmap;

// Ayarlar (Inspector'dan değiştirebilirsin)
uniform float cizgi_kalinligi : hint_range(0.0, 5.0) = 1.0;
uniform float hassasiyet : hint_range(0.0, 10.0) = 2.0; // Eşik değeri
uniform vec4 cizgi_rengi : source_color = vec4(0.0, 0.0, 0.0, 1.0); // Siyah
uniform vec4 kagit_rengi : source_color = vec4(0.95, 0.95, 0.95, 1.0); // Beyaz Kağıt

void vertex() {
	// Filtreyi kameranın gözüne yapıştır
	POSITION = vec4(VERTEX.xy, 1.0, 1.0);
}

// Derinliği \"Metre\" cinsinden düzgün okumak için matematik fonksiyonu
float get_depth(vec2 screen_uv, mat4 inv_proj_mat) {
	float depth = texture(depth_texture, screen_uv).r;
	vec3 ndc = vec3(screen_uv * 2.0 - 1.0, depth);
	vec4 view = inv_proj_mat * vec4(ndc, 1.0);
	view.xyz /= view.w;
	return -view.z; // Kameradan uzaklık (metre cinsinden)
}

void fragment() {
	// 1. Piksel boyutunu al
	vec2 e = vec2(1.0 / VIEWPORT_SIZE.xy) * cizgi_kalinligi;
	
	// 2. Etraftaki 4 noktanın derinliğini ölç (Metre cinsinden)
	float d_merkez = get_depth(SCREEN_UV, INV_PROJECTION_MATRIX);
	float d_ust    = get_depth(SCREEN_UV + vec2(0.0, e.y), INV_PROJECTION_MATRIX);
	float d_alt    = get_depth(SCREEN_UV - vec2(0.0, e.y), INV_PROJECTION_MATRIX);
	float d_sag    = get_depth(SCREEN_UV + vec2(e.x, 0.0), INV_PROJECTION_MATRIX);
	float d_sol    = get_depth(SCREEN_UV - vec2(e.x, 0.0), INV_PROJECTION_MATRIX);
	
	// 3. Farkları hesapla (Sobel Benzeri)
	// Eğer yanındaki piksel senden çok daha uzaktaysa orada bir kenar vardır.
	float fark = abs(d_ust - d_alt) + abs(d_sag - d_sol);
	
	// 4. Eşik değerine göre boya
	// Eğer fark \"hassasiyet\"ten büyükse Siyah, değilse Kağıt Rengi
	if (fark > hassasiyet * 0.1) { // 0.1 çarpanı ince ayar içindir
		ALBEDO = cizgi_rengi.rgb;
	} else {
		ALBEDO = kagit_rengi.rgb;
	}
}"

